FROM public.ecr.aws/docker/library/node:20-alpine3.21 AS dependencies

WORKDIR /app

# bcrypt may need a native fallback build when a prebuilt musl binary is not
# available for the host architecture. Build tools stay out of the final image.
RUN apk add --no-cache python3 make g++

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --non-interactive \
    && yarn cache clean


FROM public.ecr.aws/docker/library/node:20-alpine3.21 AS development

RUN apk add --no-cache tini libstdc++

WORKDIR /app

ENV NODE_ENV=development \
    PORT=3001 \
    TSC_WATCHFILE=DynamicPriorityPolling \
    TSC_WATCHDIRECTORY=RecursiveDirectoryUsingDynamicPriorityPolling \
    NODE_OPTIONS=--enable-source-maps

COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node . .

USER node

EXPOSE 3001 9229

HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=5 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/healthcheck').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["yarn", "start:docker:dev"]
