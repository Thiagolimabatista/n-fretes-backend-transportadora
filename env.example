# Modelo do .env.development (copie e preencha). Nunca versione valores reais.
# Em staging os valores vêm da task definition do ECS nfretes-staging-transportadora
# e, para os segredos, do SSM /nfretes/staging/transportadora/* e /nfretes/staging/shared/*.

# Porta HTTP. O portal local aponta para ela (NEXT_PUBLIC_API_URL no .env.local do portal).
PORT=8002

# --- Banco: Postgres compartilhado com o n-fretes-backend (motorista) e o n-fretes-workers ---
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
# O RDS exige SSL. Opcionais: DB_SSL_REJECT_UNAUTHORIZED=true (valida o certificado)
# e DATABASE_QUERY_LOGGING=true (mostra cada SQL no log).
DB_SSL=true

# --- Autenticação ---
# Assina e valida o token do portal (a validade, 30 dias, é fixa no código).
JWT_SECRET=

# --- AWS: S3 (fotos e documentos) e SQS ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=app-caminhoneiros
# Fila SharginFreightNotification: o aceite do frete publica aqui e o n-fretes-workers envia o push ao motorista.
QUEUE_SHARING_NOTIFICATION_FREIGHT=

# --- Google Maps (só no servidor) ---
# Distância entre origem e destino do frete.
GOOGLE_MAPS_API_KEY=
# Geocodificação de endereços. Se faltar, usa a GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_SERVER_API_KEY=

# --- QualP: cálculo de pedágio da rota ---
QUALP_API_KEY=

# --- WhatsApp: envio do código de recuperação de senha ---
# Sem esta URL a recuperação de senha responde 503. Ainda não existe no ECS.
WHATSAPP_2FA_WEBHOOK_URL=

# --- Cron ---
# A cada 30 min devolve para PENDING as solicitações do fluxo antigo de aceite que expiraram.
BACKGROUND_JOBS_ENABLED=true

# yarn seed:demo pede DEMO_COMPANY_PASSWORD e recusa banco remoto sem SEED_ALLOW_REMOTE=true.
